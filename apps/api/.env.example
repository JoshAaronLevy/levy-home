PORT=4000
LEVY_HOME_HA_WEBHOOK_SECRET=dev-secret

# Safe default for local development. Live mode requires the Home Assistant
# base URL and token below.
HOME_ASSISTANT_MODE=mock

# Live Home Assistant REST API settings. Do not commit real tokens.
HOME_ASSISTANT_BASE_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Curated entities/actions. These stay server-side and are never accepted from
# the iOS app request body.
HOME_ASSISTANT_GARAGE_COVER_ENTITY_ID=cover.main_garage_door
HOME_ASSISTANT_ALL_LIGHTS_ENTITY_ID=light.all_lights

# Format: groupId:Display name:entity_id,groupId:Display name:entity_id
HOME_ASSISTANT_LIGHT_GROUPS=downstairs:Downstairs lights:light.downstairs_lights,bedrooms:Bedroom lights:light.bedroom_lights

# Mock-mode display values.
MOCK_TOTAL_LIGHT_COUNT=12
