PORT=4000
LEVY_HOME_HA_WEBHOOK_SECRET=dev-secret

# Backend weather-alert polling. Disabled locally by default so dev API runs do
# not accidentally send household APNs alerts.
WEATHER_ALERTS_ENABLED=false
WEATHER_ALERTS_LATITUDE=39.5388289
WEATHER_ALERTS_LONGITUDE=-105.0305231
WEATHER_ALERTS_TIME_ZONE=America/Denver
WEATHER_ALERTS_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_ALERTS_POLL_INTERVAL_MINUTES=30
WEATHER_ALERTS_LEAD_TIME_MINUTES=60
WEATHER_ALERTS_EVENT_SEPARATION_MINUTES=180

# Optional locally, required on Render for database-backed API features.
# When set, apply migrations before deploying so notification persistence
# tables such as push_devices and notification_preferences exist.
DATABASE_URL=

# Kroger Products API diagnostic lookup. The iOS app only calls the Levy Home
# API; these credentials stay server-side.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_API_BASE_URL=https://api.kroger.com/v1
KROGER_PRODUCT_SEARCH_LIMIT=10
KROGER_LOCATION_ID=62000008
KROGER_SHOPPING_STORE_ID=2
KROGER_SHOPPING_STORE_NAME=King Soopers
KROGER_PRODUCT_RESPONSE_PATH=
KROGER_NORMALIZED_PRODUCT_RESPONSE_PATH=

# Safe default for local development. Live mode requires the Home Assistant
# base URL and token below.
HOME_ASSISTANT_MODE=mock

# Live Home Assistant REST API settings. Do not commit real tokens.
HOME_ASSISTANT_BASE_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=

# Phone activity ingestion configuration. When enabled in live mode, the API
# starts a backend WebSocket listener for configured phone entities.
HOME_ASSISTANT_ACTIVITY_ENABLED=false

# Optional override. When blank, the listener derives /api/websocket from
# HOME_ASSISTANT_BASE_URL.
HOME_ASSISTANT_WEBSOCKET_URL=

# Exact phone home-presence entities selected from the discovery helper.
# Format: entity_id:Person:Device name,entity_id:Person:Device name
HOME_ASSISTANT_PHONE_ENTITIES=device_tracker.josh_iphone:Josh:Joshs iPhone,device_tracker.mallorys_iphone:Mallory:Mallorys iPhone

# Optional explicit glob-style entity patterns for Companion App sensor groups.
# Use * as the wildcard. Format: entity_id_glob:Person:Device name.
# Leave blank for the Levy Home setup. Broad phone patterns include noisy/private
# sensors, and Activity only stores device_tracker home/away transitions.
HOME_ASSISTANT_PHONE_ENTITY_PATTERNS=

# Curated entities/actions. These stay server-side and are never accepted from
# the iOS app request body.
HOME_ASSISTANT_GARAGE_COVER_ENTITY_ID=cover.main_garage_door
# Optional fallback Home Assistant all-lights group/entity. Leave blank when
# HOME_ASSISTANT_LIGHT_ENTITIES is the source of truth for light actions.
HOME_ASSISTANT_ALL_LIGHTS_ENTITY_ID=

# Optional Home Assistant light group entities. Used when
# HOME_ASSISTANT_LIGHT_ENTITIES is blank.
# Format: groupId:Display name:entity_id,groupId:Display name:entity_id
HOME_ASSISTANT_LIGHT_GROUPS=

# Curated Home Assistant light entities. When set, the live API uses these
# exact lights for the overview and light-off actions instead of
# HOME_ASSISTANT_ALL_LIGHTS_ENTITY_ID / HOME_ASSISTANT_LIGHT_GROUPS.
# Format: entity_id: Display name, entity_id: Display name
HOME_ASSISTANT_LIGHT_ENTITIES=light.foyer_lights: Foyer, light.kitchen_cans: Kitchen Cans, light.kitchen_nook: Kitchen Nook, light.upstairs_hallway: Upstairs Hallway, light.study_lamp_1: Study Lamp 1, light.study_lamp_2: Study Lamp 2, light.study_lamp_3: Study Lamp 3, light.playroom_lamp: Playroom

# Mock-mode display values.
MOCK_TOTAL_LIGHT_COUNT=12

# APNs provider credentials for backend push delivery. Leave blank for local
# backend work that does not send push notifications. Do not commit real keys.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.levyhome.app

# Preferred: store the downloaded .p8 private key as a file and point to it.
# On Render Secret Files, this usually looks like /etc/secrets/AuthKey_ABC123.p8.
APNS_PRIVATE_KEY_PATH=

# Fallback: use the downloaded .p8 private key value with newlines escaped as \n.
# Quoting the value in a local .env file is fine. Ignored when APNS_PRIVATE_KEY_PATH is set.
APNS_PRIVATE_KEY=

# Default endpoint for APNs sends when a stored device does not include an
# environment. Native registrations should still send sandbox or production.
APNS_ENVIRONMENT=sandbox
